AERO_STORAGE=firestore
AERO_ENV=development
AERO_SERVE_FRONTEND=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=demo-aero
AERO_ADMIN_TOKEN=replace-with-a-long-random-value
AERO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AERO_MAX_BODY_BYTES=1000000
AERO_RATE_LIMIT_PER_MINUTE=60

